{
  "$schema": "https://ui.shadcn.com/schema.json",
  "name": "eduplus",
  "homepage": "https://eduplus-skills.org",
  "style": "default",
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/index.css",
    "baseColor": "slate",
    "cssVariables": true
  },
  "rsc": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils"
  },
  "items": [
    {
      "name": "immersive-hero",
      "type": "registry:ui",
      "title": "Immersive Hero",
      "description": "Premium cyber-brutalist parallax hero banner with CRT scanlines and dot-matrix patterns.",
      "dependencies": [
        "lucide-react"
      ],
      "files": [
        {
          "path": "src/components/effects/ImmersiveHero.tsx",
          "type": "registry:ui",
          "target": "components/effects/ImmersiveHero.tsx"
        }
      ]
    },
    {
      "name": "holographic-text-ring",
      "type": "registry:ui",
      "title": "Holographic Text Ring",
      "description": "Rotating 3D cybernetic text ring using Three.js and React Three Fiber.",
      "dependencies": [
        "three",
        "@types/three",
        "@react-three/fiber",
        "@react-three/drei"
      ],
      "files": [
        {
          "path": "src/components/effects/HolographicTextRing.tsx",
          "type": "registry:ui",
          "target": "components/effects/HolographicTextRing.tsx"
        }
      ]
    },
    {
      "name": "magic-card",
      "type": "registry:ui",
      "title": "Magic Card",
      "description": "Borderless cyber-brutalist interactive spotlight card using cursor coordinate glow calculations.",
      "files": [
        {
          "path": "src/components/effects/CyberVisualizations.tsx",
          "type": "registry:ui",
          "target": "components/effects/CyberVisualizations.tsx"
        }
      ]
    },
    {
      "name": "nordic-dashboard-sidebar",
      "type": "registry:ui",
      "title": "Nordic Dashboard Sidebar",
      "description": "Nordic Lagom admin sidebar using shadcn Sidebar primitives. Collapsible to icon rail, user identity badge with role, grouped nav sections, amber accent, no rounded corners.",
      "dependencies": [
        "lucide-react",
        "react-router"
      ],
      "registryDependencies": [
        "sidebar",
        "avatar",
        "badge",
        "animated-theme-toggler"
      ],
      "files": [
        {
          "path": "src/components/dashboard/DashboardSidebar.tsx",
          "type": "registry:ui",
          "target": "components/dashboard/DashboardSidebar.tsx"
        },
        {
          "path": "src/i18n/useTranslation.ts",
          "type": "registry:hook",
          "target": "i18n/useTranslation.ts"
        }
      ]
    }
  ]
}
